# YouTube Data API v3 Key (from Google Cloud Console)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Groq API Key (from console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Database URL:
# For local SQLite:
DATABASE_URL=sqlite:///./youtube_knowledge_graph.db
# For Cloud PostgreSQL (Neon, Supabase, Render, Railway):
# DATABASE_URL=postgresql://username:password@ep-xyz.neon.tech/neondb?sslmode=require

# ChromaDB Vector Directory
CHROMA_DB_DIR=./chroma_db

# LLM Model Configuration
GROQ_MODEL=llama-3.3-70b-versatile

# Embedding Model
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
